to":0,"pf":1,"num":"2"},{"name":"Jamias Ferere","pos":"G","starter":false,"dnp":false,"min":18,"pts":6,"fgm":1,"fga":5,"tpm":0,"tpa":1,"ftm":4,"fta":4,"oreb":0,"dreb":1,"reb":1,"ast":0,"stl":0,"blk":0,"to":4,"pf":1,"num":"0"},{"name":"Ace Talbert","pos":"G","starter":false,"dnp":false,"min":14,"pts":0,"fgm":0,"fga":1,"tpm":0,"tpa":0,"ftm":0,"fta":0,"oreb":0,"dreb":0,"reb":0,"ast":1,"stl":0,"blk":0,"to":0,"pf":1,"num":"25","photo":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/5177284.png"},{"name":"Chinedu Okpara","pos":"F","starter":false,"dnp":true,"num":"24"}]}],"odds":{"provider":"DraftKings","details":"CONN -41.5","spread":-41.5,"overUnder":147.5,"favorite":"home","homeML":null,"awayML":null},"espnId":"401911390","article":{"headline":"Mullins and Khamenia lead No. 4 UConn past Gardner-Webb 86-46 for Hurley's 200th win with Huskies","story":"HARTFORD, Conn. -- — <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/5196916/braylon-mullins\">Braylon Mullins</a> scored 20 points and <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/5144124/nik-khamenia\">Nik Khamenia</a> added 14 points and six rebounds as <a href=\"https://apnews.com/article/ap-top-25-basketball-poll-982b01c92f181da50646b3a2cc8c7c9d\">No. 4 UConn</a> beat Gardner-Webb 86-46 on Monday night.\n\n\r\n              <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/5292602/na'jai-hines\">Na'jai Hines</a> had 12 points and 12 rebounds, <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/5292585/colben-landrew\">Colben Landrew</a> added 11 points and five boards, and <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/5054083/silas-demary-jr\">Silas Demary Jr</a>. finished with eight rebounds and eight assists as the Huskies (1-0) won their 10th consecutive season opener. They improved to 9-0 in openers under coach Dan Hurley, who earned his 200th win at UConn.\n\n\r\n              <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/5240417/jacob-hudson\">Jacob Hudson</a> had nine points for Gardner-Webb (0-1), but the starters for the Runnin' Bulldogs missed 24 of their 31 field-goal attempts. <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/5316030/seth-brown\">Seth Brown</a> and <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/4870563/jackson-skipper\">Jackson Skipper</a> added eight points apiece.\n\n\r\n              Mullins scored eight of UConn's 14 points in the first five minutes of the second half to push a 19-point halftime advantage to a 28-point lead. \n\n\r\n              Gardner-Webb missed eight of its first nine shots and had just two field goals in the opening 13 minutes. The Runnin’ Bulldogs had baskets on consecutive possessions just once in the first half as they shot only 25.5% from the field.\n\n\r\n              Six of the nine UConn players who appeared in the first half were making their debut with the Huskies. Five of the six newcomers had at least one basket as the Huskies led 43-24 at halftime. \n\n\r\n              UConn shot 55% in the second half and had assists on 15 of 17 baskets.\n\n\r\n              <hl2>Up next</hl2>\r\n              Gardner-Webb plays at No. 7 Texas on Thursday.\n\n\r\n              UConn faces No. 16 Michigan in Boston on Friday.\n\n\r\n              ------\n\n\r\n              A previous version of this story corrected Na’jai Hines' rebound total to 12.\n\n\r\n              ------\n\n\r\n              <a href=\"https://apnews.com/newsletters\">Sign up for Top 25 poll alerts here</a>, visit <a href=\"https://apnews.com/hub/ap-top-25-college-basketball-poll\">the Top 25 here</a> and see AP’s full <a href=\"https://apnews.com/hub/mens-college-basketball\">men’s basketball coverage here</a>","byline":"AP","images":[]},"videos":[],"hasPlays":true},"2027-2":{"venue":{"name":"TD Garden","city":"Boston, MA"},"att":null,"officials":["John Gaffney","Brian Dorsey","Tony Henderson"],"tv":"TNT","teams":[{"name":"UConn","abbr":"CONN","logo":"https://a.espncdn.com/i/teamlogos/ncaa/500/41.png","color":"0c2340","rank":4,"record":"1-0","score":10,"line":[10],"stats":{"fg_pct":50,"tp_pct":67,"ft_pct":0,"reb":3,"oreb":1,"ast":1,"stl":1,"blk":1,"to":1,"pot":4,"fast":0,"paint":4,"pf":2,"lead":5,"bench":0},"players":[{"name":"Nik Khamenia","pos":"F","starter":true,"dnp":false,"min":4,"pts":2,"fgm":1,"fga":1,"tpm":0,"tpa":0,"ftm":0,"fta":0,"oreb":0,"dreb":0,"reb":0,"ast":1,"stl":0,"blk":1,"to":0,"pf":1,"num":"4","pid":"espn-5144124","photo":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/5144124.png"},{"name":"Jayden Ross","pos":"F","starter":true,"dnp":false,"min":4,"pts":0,"fgm":0,"fga":2,"tpm":0,"tpa":1,"ftm":0,"fta":0,"oreb":1,"dreb":1,"reb":2,"ast":0,"stl":0,"blk":0,"to":0,"pf":0,"num":"23","pid":"jayden-ross-2","photo":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/4895753.png"},{"name":"Na'jai Hines","pos":"C","starter":true,"dnp":false,"min":3,"pts":0,"fgm":0,"fga":0,"tpm":0,"tpa":0,"ftm":0,"fta":0,"oreb":0,"dreb":0,"reb":0,"ast":0,"stl":0,"blk":0,"to":1,"pf":1,"num":"9","pid":"espn-5292602","photo":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/5292602.png"},{"name":"Braylon Mullins","pos":"G","starter":true,"dnp":false,"min":4,"pts":6,"fgm":2,"fga":2,"tpm":2,"tpa":2,"ftm":0,"fta":0,"oreb":0,"dreb":1,"reb":1,"ast":0,"stl":0,"blk":0,"to":0,"pf":0,"num":"24","pid":"braylon-mullins-1","photo":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/5196916.png"},{"name":"Silas Demary Jr.","pos":"G","starter":true,"dnp":false,"min":4,"pts":2,"fgm":1,"fga":3,"tpm":0,"tpa":0,"ftm":0,"fta":0,"oreb":0,"dreb":0,"reb":0,"ast":0,"stl":1,"blk":0,"to":0,"pf":0,"num":"5","pid":"silas-demary-jr-2","photo":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/5054083.png"},{"name":"Egor Amosov","pos":"F","starter":false,"dnp":true,"num":"17","pid":"es