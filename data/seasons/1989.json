{"y":1989,"label":"1988–89","coach":"Jim Calhoun","conf":"Big East","confShort":"Big East","w":18,"l":13,"cw":6,"cl":10,"confFinish":"7th in Big East","finish":"nit","apHigh":18,"srs":13.61,"sos":7.26,"ortg":101.8,"drtg":92.9,"ppg":72.7,"oppg":66.4,"story":{"headline":"Knocking on the Door","text":"Calhoun's third team took another step, going 18–13 overall and 6–10 in a brutal Big East. The signature night came on January 16, 1989, when UConn beat No. 11 Syracuse 68–62 at the Hartford Civic Center. Clifford Robinson, in his final season, earned second-team All-Big East honors. After a 74–66 loss to Seton Hall in the Big East quarterfinals, the Huskies returned to the NIT and won twice more — 67–62 at Charlotte and a 73–72 thriller over California in Hartford — before UAB ended the run 85–79 in the quarterfinals at the Field House. Robinson went to the Portland Trail Blazers with the 36th pick of the 1989 NBA draft. The foundation was set; the breakthrough was one season away.","moments":[{"date":"1989-03-22","title":"NIT Quarterfinals: L vs UAB","text":"UConn lost to UAB 79–85 (Quarterfinals) at Hugh S. Greer Field House, Storrs, Connecticut."}],"sources":["https://en.wikipedia.org/wiki/1988%E2%80%9389_Connecticut_Huskies_men's_basketball_team","https://en.wikipedia.org/wiki/UConn_Huskies_men%27s_basketball"]},"roster":[{"pid":"clifford-robinson-1","name":"Cliff Robinson","num":"00","cls":"SR","pos":"C","ht":"6-10","wt":225,"home":"Buffalo, NY","pg":{"g":31,"gs":30,"mp":31.4,"pts":20.0,"trb":7.4,"ast":1.5,"stl":1.8,"blk":1.4,"tov":2.4,"fg_pct":0.47,"fg3_pct":0.333,"ft_pct":0.684,"orb":null,"pf":3.4},"tot":{"mp":974,"fg":235,"fga":500,"fg3":4,"fg3a":12,"ft":145,"fta":212,"orb":null,"drb":null,"trb":228,"ast":46,"stl":55,"blk":44,"tov":75,"pf":104,"pts":619,"g":31},"adv":{"per":null,"ts_pct":0.515,"efg_pct":0.474,"usg_pct":null,"ast_pct":null,"trb_pct":null,"stl_pct":null,"blk_pct":null,"ws":null,"ws_per_40":null,"bpm":null,"obpm":null,"dbpm":null}},{"pid":"phil-gamb