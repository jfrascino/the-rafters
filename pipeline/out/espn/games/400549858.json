 Jumper.",1,8,6,"53045","20558","JumpShot"],[2,"3:56","127",49,45,0,0,"Branden Dawson Defensive Rebound.",0,25,0,"56933","587","Defensive Rebound"],[2,"3:51","127",49,45,0,0,"Branden Dawson Turnover.",0,25,0,"56933","598","Lost Ball Turnover"],[2,"3:51","41",49,45,0,0,"Ryan Boatright Steal.",0,25,0,"56634","607","Steal"],[2,"3:49","127",49,45,0,0,"Foul on Denzel Valentine.",0,25,0,"62615","519","PersonalFoul"],[2,"3:49",null,49,45,0,0," Official TV Timeout",0,25,0,null,"580","OfficialTVTimeOut"],[2,"3:49","41",50,45,1,1,"Ryan Boatright made Free Throw.",1,null,null,"56634","540","MadeFreeThrow"],[2,"3:49","41",51,45,1,1,"Ryan Boatright made Free Throw.",1,null,null,"56634","540","MadeFreeThrow"],[2,"3:37","41",51,45,0,0,"Foul on DeAndre Daniels.",0,25,0,"56635","519","PersonalFoul"],[2,"3:37","127",51,46,1,1,"Branden Dawson made Free Throw.",1,null,null,"56933","540","MadeFreeThrow"],[2,"3:37","127",51,47,1,1,"Branden Dawson made Free Throw.",1,null,null,"56933","540","MadeFreeThrow"],[2,"3:08","41",51,47,0,3,"Ryan Boatright missed Three Point Jumper.",1,35,21,"56634","30558","Three Point Jump Shot"],[2,"3:08","127",51,47,0,0,"Michigan St Defensive Rebound.",0,25,0,null,"587","Defensive Rebound"],[2,"2:40","127",51,49,1,2,"Keith Appling made Jumper.",1,17,4,"51546","20558","JumpShot"],[2,"2:26","41",51,49,0,3,"Niels Giffey missed Three Point Jumper.",1,2,2,"53045","30558","Three Point Jump Shot"],[2,"2:26","127",51,49,0,0,"Denzel Valentine Defensive Rebound.",0,25,0,"62615","587","Defensive Rebound"],[2,"2:03","127",51,49,0,0,"Branden Dawson Turnover.",0,25,0,"56933","598","Lost Ball Turnover"],[2,"1:45","41",53,49,1,2,"Shabazz Napier made Jumper.",1,32,14,"51455","20558","JumpShot"],[2,"1:24","127",53,49,0,0,"Michigan St  Timeout",0,25,0,null,"579","ShortTimeOut"],[2,"1:18","127",53,49,0,2,"Gary Harris missed Jumper.",1,28,14,"62613","20558","JumpShot"],[2,"1:18","127",53,49,0,0,"Michigan St Offensive Rebound.",0,25,0,null,"586","Offensive Rebound"],[2,"0:57","41",53,49,0,0,"Foul on Phillip Nolan.",0,25,0,"61579","519","PersonalFoul"],[2,"0:57","127",53,50,1,1,"Adreian Payne made Free Throw.",1,null,null,"51545","540","MadeFreeThrow"],[2,"0:57","127",53,51,1,1,"Adreian Payne made Free Throw.",1,null,null,"51545","540","MadeFreeThrow"],[2,"0:30","127",53,51,0,0,"Foul on Keith Appling.",0,25,0,"51546","519","PersonalFoul"],[2,"0:30","41",54,51,1,1,"Shabazz Napier made Free Throw.",1,null,null,"51455","540","MadeFreeThrow"],[2,"0:30","41",55,51,1,1,"Shabazz Napier made Free Throw.",1,null,null,"51455","540","MadeFreeThrow"],[2,"0:30","41",56,51,1,1,"Shabazz Napier made Free Throw.",1,null,null,"51455","540","MadeFreeThrow"],[2,"0:27","127",56,51,0,3,"Travis Trice missed Three Point Jumper.",1,40,21,"56934","30558","Three Point Jump Shot"],[2,"0:27","41",56,51,0,0,"DeAndre Daniels Defensive Rebound.",0,25,0,"56635","587","Defensive Rebound"],[2,"0:15","41",58,51,1,2,"Phillip Nolan made Dunk. Assisted by Shabazz Napier.",1,23,3,"61579","20574","DunkShot"],[2,"0:11","127",58,51,0,3,"Adreian Payne missed Three Point Jumper.",1,45,16,"51545","30558","Three Point Jump Shot"],[2,"0:11","41",58,51,0,0,"Niels Giffey Defensive Rebound.",0,25,0,"53045","587","Defensive Rebound"],[2,"0:06","127",58,51,0,0,"Foul on Denzel Valentine.",0,25,0,"62615","519","PersonalFoul"],[2,"0:06","41",59,51,1,1,"Niels Giffey made Free Throw.",1,null,null,"53045","540","MadeFreeThrow"],[2,"0:06","127",59,51,0,0,"Michigan St  Timeout",0,25,0,null,"579","ShortTimeOut"],[2,"0:06","41",60,51,1,1,"Niels Giffey made Free Throw.",1,null,null,"53045","540","MadeFreeThrow"],[2,"0:01","127",60,54,1,3,"Dan Chapman made Three Point Jumper. Assisted by Travis Trice.",1,11,19,"53799","30558","Three Point Jump Shot"],[2,"0:00",null,60,54,0,0,"End of Game",0,50,-5,null,"402","End Game"]],"wp":[],"article":{"headline":"Shabazz Napier, No. 7 seed UConn top Michigan St. to reach Final Four","description":"Shabazz Napier scored 17 of his 25 points in the second half, and UConn beat Michigan State 60-54 to return to the Final Four a year after the Huskies were barred from the NCAA tournament.","type":"Recap","source":"Associated Press","published":"2014-03-31T04:22:05Z","story":"<p>NEW YORK -- <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/51455/shabazz-napier\">Shabazz Napier</a> owed <a href=\"http://www.espn.com/mens-college-basketball/team/_/id/41/connecticut-huskies\">UConn</a>.</p>\n<p>He could have transferred when academic sanctions barred the Huskies from the NCAA tournament his junior season. But the guard wanted to pay back the school for the joy of a national title his freshman year, for his struggles as a sophomore.</p>\n<p><inline1></p>\n<p>Napier sure did that Sunday, carrying UConn back to the Final Four in front of thousands of roaring Huskies fans at Madison Square Garden. He scored 17 of his 25 points in the second half in a 60-54 upset of fourth-seeded <a href=\"http://www.espn.com/mens-college-basketball/team/_/id/127/michigan-state-spartans\">Michigan State</a>.</p>\n<p>The East Regional's most outstanding player hit three huge free throws with 37.6 seconds left, making clutch shot after clutch shot just as <a href=\"http://www.espn.com/nba/player/_/id/6479/kemba-walker\">Kemba Walker</a> did when Napier was a freshman. The Huskies (30-8) rallied from a nine-point second-half deficit to become the first No. 7 seed to reach the Final Four since the tournament expanded to 64 teams in 1985.</p>\n<p>\"His will to win -- you could just see it,\" said <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/62613/gary-harris\">Gary Harris</a>, who led Michigan State with 22 points. \"He wasn't going to let his team lose.\"</p>\n<p>The Spartans' seniors become the first four-year players recruited by Tom Izzo to fail to make a Final Four.</p>\n<p>\"As the game got closer and closer to ending, it was on my mind a lot, every huddle,\" said big man <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/51545/adreian-payne\">Adreian Payne</a>, who had 13 points and nine rebounds but was repeatedly pushed to the perimeter by UConn's defenders.</p>\n<p>The undersized Huskies matched Michigan State's physical play box-out for box-out, holding the Spartans (29-9) to just six offensive rebounds and six points in the paint.</p>\n<p>\"We're physical, too,\" said second-year coach Kevin Ollie, who is now 4-0 in the NCAA tournament after replacing mentor Jim Calhoun. \"Don't get it mixed up. We are predators out there.\"</p>\n<p>UConn dared Michigan State to shoot 3-pointers, and the Spartans nearly made enough, going 11 for 29 from behind the arc. Harris was 4 for 9 on 3s, but his teammates were a combined 10 for 32 from the floor.</p>\n<p>Trailing 51-49 with more than two minutes left, Michigan State had a chance to tie or take the lead. Payne fumbled the ball away, and Napier drilled a jumper on the other end.</p>\n<p>After Payne's free throws pulled the Spartans back within two, <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/51546/keith-appling\">Keith Appling</a> was whistled for a foul -- his fifth -- for contact with Napier on a 3-point attempt. Napier extended the lead to 56-51, and after <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/56934/travis-trice\">Travis Trice</a> missed a 3, <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61579/phillip-nolan\">Phillip Nolan</a> slipped free for a dunk that clinched the victory.</p>\n<p>\"We got what we deserved today,\" Izzo said. \"I tried to tell these guys that, when you get to the tournament, you got to bring it every second. And today Connecticut did, and we just kind of weren't as good as we have been.\"</p>\n<p><a href=\"http://www.espn.com/mens-college-basketball/player/_/id/56634/ryan-boatright\">Ryan Boatright</a> made four steals as Michigan State committed 16 turnovers. Some were caused by UConn's quickness, others by what Izzo called poor decisions by the Spartans.</p>\n<p><a href=\"http://www.espn.com/mens-college-basketball/player/_/id/56635/deandre-daniels\">DeAndre Daniels</a> shut down <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/56933/branden-dawson\">Branden Dawson</a>, who scored 24 points in Michigan State's Sweet 16 win over top-seeded Virginia. Dawson attempted just three field goals, making one, to finish with five points.</p>\n<p><inline2></p>\n<p>The 6-foot-10, 245-pound Payne hit two long jumpers to put Michigan State up 32-23 less than four minutes into the second half. But Napier started driving, getting the bigger Appling in foul trouble and UConn back in the game.</p>\n<p>\"When Coach looks at me a certain way, I just know I got to be more aggressive,\" said Napier, who passed <a href=\"http://www.espn.com/nba/player/_/id/9/ray-allen\">Ray Allen</a> for fourth on the Huskies' all-time scoring list with 1,925 points.</p>\n<p>After hitting four straight free throws to tie the score at 32 with 12:38 left, Napier was struck in the face by Harris -- the UConn guard was called for a foul on the play -- and left the court with his nose gushing blood. He was back less than a minute later when Daniels completed a three-point play to give the Huskies the lead for good.</p>\n<p>Boatright's contested 3-pointer with the shot clock winding down put UConn up 49-39 with less than seven minutes left.</p>\n<p>The Huskies won their third national title in 2011, but they were ineligible for last year's tournament because of previous low scores on the NCAA's academic progress measure.</p>\n<p>They face Florida in the national semifinals Saturday, and they'll be confident they can beat the No. 1 overall seed. The Gators have won 30 straight, but their last loss was to UConn, 65-64 on Dec. 2.</p>\n<p>After the Huskies were routed 81-48 by Louisville in the regular-season finale, Ollie showed his players video of that victory to remind them of what happens when they play frenetic defense.</p>\n<p>\"We're going to be well prepared, because I know about these guys' heart,\" Ollie said. \"That's what got us through: It was a heart of a champion, heart of a lion.\"</p>\n\n\n\n\n","images":[{"url":"https://a.espncdn.com/photo/2014/0330/ncb_u_shabts_576x324.jpg","caption":null,"credit":"Brad Penner/USA TODAY Sports","width":576,"height":324}]},"videos":[],"news":[],"source":{"summary":true,"boxscore":"full","playByPlay":"full"}}