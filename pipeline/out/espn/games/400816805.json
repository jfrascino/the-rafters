",42,64,0,0,"JaQuan Lyle Defensive Rebound.",0,null,null,"3134899","587","Defensive Rebound"],[2,"5:30","41",42,64,0,0,"Foul on Jalen Adams.",0,null,null,"3934622","519","PersonalFoul"],[2,"5:30","194",43,64,1,1,"Marc Loving made Free Throw.",1,null,null,"66343","540","MadeFreeThrow"],[2,"5:30","194",44,64,1,1,"Marc Loving made Free Throw.",1,null,null,"66343","540","MadeFreeThrow"],[2,"5:30","194",44,64,0,0,"Ohio State  Timeout",0,null,null,null,"579","ShortTimeOut"],[2,"5:24","194",44,64,0,0,"Foul on Daniel Giddens.",0,null,null,"3912274","519","PersonalFoul"],[2,"5:24","41",44,64,0,1,"Rodney Purvis missed Free Throw.",1,null,null,"61157","540","MadeFreeThrow"],[2,"5:24","41",44,65,1,1,"Rodney Purvis made Free Throw.",1,null,null,"61157","540","MadeFreeThrow"],[2,"5:24","194",44,65,0,0,"Daniel Giddens Turnover.",0,null,null,"3912274","598","Lost Ball Turnover"],[2,"5:17","41",44,67,1,2,"Shonn Miller made Dunk. Assisted by Rodney Purvis.",1,null,null,"56330","20574","DunkShot"],[2,"5:00","194",44,67,0,3,"Austin Grandstaff missed Three Point Jumper.",1,null,null,"3912273","30558","Three Point Jump Shot"],[2,"5:00","41",44,67,0,0,"Shonn Miller Defensive Rebound.",0,null,null,"56330","587","Defensive Rebound"],[2,"4:39","41",44,67,0,0,"Omar Calhoun Turnover.",0,null,null,"61578","598","Lost Ball Turnover"],[2,"4:37","194",44,67,0,0,"Daniel Giddens Steal.",0,null,null,"3912274","607","Steal"],[2,"4:35","194",46,67,1,2,"Marc Loving made Layup.",1,null,null,"66343","20572","LayUpShot"],[2,"4:34","41",46,69,1,2,"Amida Brimah made Dunk. Assisted by Rodney Purvis.",1,null,null,"66679","20574","DunkShot"],[2,"4:11","194",46,69,0,2,"Daniel Giddens missed Jumper.",1,null,null,"3912274","20558","JumpShot"],[2,"4:11","41",46,69,0,0,"Omar Calhoun Defensive Rebound.",0,null,null,"61578","587","Defensive Rebound"],[2,"3:48","41",46,69,0,0,"Omar Calhoun Turnover.",0,null,null,"61578","598","Lost Ball Turnover"],[2,"3:46",null,46,69,0,0," Official TV Timeout",0,null,null,null,"580","