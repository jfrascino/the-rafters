missed Three Point Jumper.",1,null,null,"3934622","30558","Three Point Jump Shot"],[2,"1:52","130",63,55,0,0,"Derrick Walton Jr. Defensive Rebound.",0,null,null,"66184","587","Defensive Rebound"],[2,"1:41","130",63,55,0,3,"Zak Irvin missed Three Point Jumper.",1,null,null,"66186","30558","Three Point Jump Shot"],[2,"1:41","41",63,55,0,0,"Rodney Purvis Defensive Rebound.",0,null,null,"61157","587","Defensive Rebound"],[2,"1:29","41",63,55,0,0,"Connecticut  Timeout",0,null,null,null,"579","ShortTimeOut"],[2,"1:11","41",66,55,1,3,"Daniel Hamilton made Three Point Jumper.",1,null,null,"3147351","30558","Three Point Jump Shot"],[2,"0:53","130",66,55,0,3,"Aubrey Dawkins missed Three Point Jumper.",1,null,null,"3136493","30558","Three Point Jump Shot"],[2,"0:53","130",66,55,0,0,"Caris LeVert Offensive Rebound.",0,null,null,"61810","586","Offensive Rebound"],[2,"0:47","130",66,55,0,2,"Caris LeVert missed Two Point Tip Shot.",1,null,null,"61810","20437","TipShot"],[2,"0:47","41",66,55,0,0,"Shonn Miller Defensive Rebound.",0,null,null,"56330","587","Defensive Rebound"],[2,"0:46","130",66,55,0,0,"Foul on Duncan Robinson.",0,null,null,"3157465","519","PersonalFoul"],[2,"0:46","41",67,55,1,1,"Shonn Miller made Free Throw.",1,null,null,"56330","540","MadeFreeThrow"],[2,"0:46","41",68,55,1,1,"Shonn Miller made Free Throw.",1,null,null,"56330","540","MadeFreeThrow"],[2,"0:43","130",68,58,1,3,"Derrick Walton Jr. made Three Point Jumper.",1,null,null,"66184","30558","Three Point Jump Shot"],[2,"0:41","130",68,58,0,0,"Michigan  Timeout",0,null,null,null,"578","RegularTimeOut"],[2,"0:41","130",68,58,0,0,"Foul on Derrick Walton Jr..",0,null,null,"66184","519","PersonalFoul"],[2,"0:41","41",68,58,0,1,"Sterling Gibbs missed Free Throw.",1,null,null,"57408","540","MadeFreeThrow"],[2,"0:41","130",68,58,0,0,"Aubrey Dawkins Defensive Rebound.",0,null,null,"3136493","587","Defensive Rebound"],[2,"0:34","41",68,58,0,0,"Foul on Shonn Miller.",0,null,null,"56330","519","PersonalFoul"],[2,"0:34","130",68,59,1,1,"Caris LeVert made Free Throw.",1,null,null,"61810","540","MadeFreeThrow"],[2,"0:34","130",68,60,1,1,"Caris LeVert made Free Throw.",1,null,null,"61810","540","MadeFreeThrow"],[2,"0:31","130",68,60,0,0,"Foul on Derrick Walton Jr..",0,null,null,"66184","519","PersonalFoul"],[2,"0:31","41",69,60,1,1,"Shonn Miller made Free Throw.",1,null,null,"56330","540","MadeFreeThrow"],[2,"0:31","41",70,60,1,1,"Shonn Miller made Free Throw.",1,null,null,"56330","540","MadeFreeThrow"],[2,"0:24","130",70,60,0,0,"Caris LeVert Turnover.",0,null,null,"61810","598","Lost Ball Turnover"],[2,"0:23","41",70,60,0,0,"Daniel Hamilton Steal.",0,null,null,"3147351","607","Steal"],[2,"0:21","41",72,60,1,2,"Rodney Purvis made Dunk. Assisted by Daniel Hamilton.",1,null,null,"61157","20574","DunkShot"],[2,"0:14","130",72,60,0,3,"Aubrey Dawkins missed Three Point Jumper.",1,null,null,"3136493","30558","Three Point Jump Shot"],[2,"0:14","41",72,60,0,0,"Jalen Adams Defensive Rebound.",0,null,null,"3934622","587","Defensive Rebound"],[2,"0:11","130",72,60,0,0,"Foul on Duncan Robinson.",0,null,null,"3157465","519","PersonalFoul"],[2,"0:11","41",73,60,1,1,"Jalen Adams made Free Throw.",1,null,null,"3934622","540","MadeFreeThrow"],[2,"0:11","41",74,60,1,1,"Jalen Adams made Free Throw.",1,null,null,"3934622","540","MadeFreeThrow"],[2,"0:07","130",74,60,0,3,"D.J. Wilson missed Three Point Jumper.",1,null,null,"3136491","30558","Three Point Jump Shot"],[2,"0:07","41",74,60,0,0,"Sterling Gibbs Defensive Rebound.",0,null,null,"57408","587","Defensive Rebound"],[2,"0:00",null,74,60,0,0,"End of Game",0,null,null,null,"402","End Game"]],"wp":[],"article":{"headline":"No. 18 UConn survives Michigan rally in 74-60 win in Bahamas","description":"Daniel Hamilton had 16 points, nine rebounds and nine assists, and No. 18 UConn beat Michigan 74-60 on Wednesday night in the opening round of the Battle 4 Atlantis.","type":"Recap","source":"Associated Press","published":"2015-11-26T13:51:29Z","story":"PARADISE ISLAND, Bahamas --  <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/3147351/daniel-hamilton\">Daniel Hamilton</a> and UConn put together a solid all-around performance, and Michigan was unable to keep up with the talented Huskies.\n\nHamilton had 16 points, nine rebounds and nine assists, and No. 18 Connecticut beat the Wolverines 74-60 on Wednesday night in the opening round of the Battle 4 Atlantis.\n\nThe Huskies (4-0) dominated most of the second half, leading by as many as 19. The lead dissipated down the stretch, but they were able to get some clutch baskets in the final minutes.\n\nUConn coach Kevin Ollie said discipline was important for his team against the feisty Wolverines.\n\n\"We had to game plan this one out there -- the whole night,\" he said. \"We had our principles and they stayed solid the whole night. We just had contributions from every area. ... I thought our preparation was wonderful and guys really executed the game plan.\"\n\n<a href=\"http://www.espn.com/mens-college-basketball/player/_/id/56330/shonn-miller\">Shonn Miller</a> and <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61157/rodney-purvis\">Rodney Purvis</a> each had 13 points for the Huskies.\n\n\"We just take what the defense gives us,\" Purvis said. \"We have several different options, so it's kind of hard to focus on one guy.\"\n\n<a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61810/caris-levert\">Caris LeVert</a> led Michigan with 21 points. The Wolverines shot 32 percent from the field.\n\nThe Wolverines (2-2) got as close as eight late, but couldn't sting together enough offense. They also had few answers for Connecticut's frontcourt.\n\nAfter trailing for most of the half, Michigan closed to 63-55 on a basket by LeVert with less than four minutes to play. Coming out of a timeout, Hamilton got free and drained a 3-pointer from the top of the key.\n\nFollowing a Michigan miss on the other end, Connecticut was fouled and Miller made two free throws to push the lead up to 13.\n\nThe Huskies also had their way on the boards, building a 42-31 advantage on the glass.\n\nMichigan jumped out to a quick first-half lead, but UConn responded with a 19-4 spurt to take control. Michigan coach John Beilein said the run was the result of self-inflicted wounds.\n\n\"We took some really bad shots and sort of shot ourselves out of the game there in that little span, where we gotta know what is a really good shot, and not the first one that we look at,\" he said.\n\nTIP-INS\n\nMichigan: The Wolverines shot just 21 percent (6 for 25) from the field in the first half.\n\nUConn: The Huskies were 5 for 11 from 3-point line in the first half.\n\nBIG EAST REUNION\n\nIt will be a reunion of sorts Thursday when the Huskies face Syracuse in the semifinals. Though he was young, Purvis does have a sense of some of the wild history the former Big East rivals share.\n\n\"I remember being in high school when they went into (six) overtimes (in 2009),\" he said. \"My mom let me stay up and watch that game. So I think to be a part of that game, it should be really good.\"\n\nNO FRUSTRATION\n\nBeilein said he isn't stressing too much about the early deficiencies his team is showing through their first four games.\n\n\"It doesn't frustrate me one bit,\" he said. \"I trust these guys. I just wish our learning curve was faster. But for some reason with this team it edges along, and edges along. We'll just keep working with them without stopping.\"\n\nUP NEXT\n\nMichigan faces Charlotte in the consolation bracket.\n\nConnecticut plays Syracuse in Thursday's semifinals.","images":[]},"videos":[],"news":[],"source":{"summary":true,"boxscore":"full","playByPlay":"full"}}