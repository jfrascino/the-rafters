",1,48,-1,"61797","30558","Three Point Jump Shot"],[2,"1:13","41",65,39,0,0,"Foul on Steven Enoch.",0,25,0,"3934623","519","PersonalFoul"],[2,"1:13","2116",65,40,1,1,"Chad Brown made Free Throw.",1,null,null,"3904623","540","MadeFreeThrow"],[2,"1:13","2116",65,40,0,1,"Chad Brown missed Free Throw.",1,null,null,"3904623","540","MadeFreeThrow"],[2,"1:13","41",65,40,0,0,"Kentan Facey Defensive Rebound.",0,25,0,"66680","587","Defensive Rebound"],[2,"1:02","41",67,40,1,2,"Omar Calhoun made Layup.",1,28,2,"61578","20572","LayUpShot"],[2,"0:50","41",67,40,0,0,"Foul on Sam Cassell Jr..",0,25,0,"61797","519","PersonalFoul"],[2,"0:50","2116",67,40,0,1,"Daiquan Walker missed Free Throw.",1,null,null,"61356","540","MadeFreeThrow"],[2,"0:50","41",67,40,0,0,"Kentan Facey Defensive Rebound.",0,25,0,"66680","587","Defensive Rebound"],[2,"0:28","2116",67,40,0,0,"Foul on Chad Brown.",0,25,0,"3904623","519","PersonalFoul"],[2,"0:28","41",67,40,0,1,"Steven Enoch missed Free Throw.",1,null,null,"3934623","540","MadeFreeThrow"],[2,"0:28","2116",67,40,0,0,"Chad Brown Defensive Rebound.",0,25,0,"3904623","587","Defensive Rebound"],[2,"0:17","2116",67,40,0,2,"A.J. Davis missed Jumper.",1,30,6,"66271","20558","JumpShot"],[2,"0:17","2116",67,40,0,0,"Shaheed Davis Offensive Rebound.",0,25,0,"3132068","586","Offensive Rebound"],[2,"0:11","2116",67,40,0,2,"Shaheed Davis missed Layup.",1,22,2,"3132068","20572","LayUpShot"],[2,"0:11","2116",67,40,0,0,"Shaheed Davis Offensive Rebound.",0,25,0,"3132068","586","Offensive Rebound"],[2,"0:11","41",67,40,0,0,"Foul on Steven Enoch.",0,25,0,"3934623","519","PersonalFoul"],[2,"0:11","2116",67,40,0,1,"Shaheed Davis missed Free Throw.",1,null,null,"3132068","540","MadeFreeThrow"],[2,"0:11","2116",67,40,0,0,"UCF Deadball Team Rebound.",0,25,0,null,"449","Dead Ball Rebound"],[2,"0:11","2116",67,41,1,1,"Shaheed Davis made Free Throw.",1,null,null,"3132068","540","MadeFreeThrow"],[2,"0:00",null,67,41,0,0,"End of Game",0,50,-5,null,"402","End Game"]],"wp":[],"article":{"headline":"Connecticut rolls past Central Florida 67-41","description":"Shonn Miller scored 11 points, hauled in eight rebounds and had five steals to lead Connecticut to a 67-41 win over Central Florida on Sunday.","type":"Recap","source":"Associated Press","published":"2016-01-31T23:26:53Z","story":"ORLANDO, Fla. --  <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/56330/shonn-miller\">Shonn Miller</a> scored 11 points, hauled in eight rebounds and had five steals to lead Connecticut to a 67-41 win over Central Florida on Sunday.\n\n<a href=\"http://www.espn.com/mens-college-basketball/player/_/id/3934622/jalen-adams\">Jalen Adams</a> added 10 points  while <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/3147351/daniel-hamilton\">Daniel Hamilton</a>, <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/57408/sterling-gibbs\">Sterling Gibbs</a> and <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61157/rodney-purvis\">Rodney Purvis</a> had nine apiece for UConn (15-6, 5-3 American), which held UCF to just 24 percent shooting and controlled the glass 41-33.\n\nUCF (10-9, 4-4) got the first bucket of the game and led 4-2 before UConn took control by scoring the next 19 points to build a double-digit advantage it would hold the rest of the way. Purvis and <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61578/omar-calhoun\">Omar Calhoun</a> and both hit 3-pointers in the run and the Huskies rolled to a 38-20 advantage at the break and bounced back from Thursday's 58-57 loss to Cincinnati.\n\n<a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61357/matt-williams\">Matt Williams</a> had 10 points to lead Central Florida, which finished with its lowest score of the season.","images":[]},"videos":[],"news":[],"source":{"summary":true,"boxscore":"full","playByPlay":"full"}}