"],[2,"3:15","248",64,64,1,1,"Ronnie Johnson made Free Throw.",1,null,null,"61275","540","MadeFreeThrow"],[2,"3:15","248",65,64,1,1,"Ronnie Johnson made Free Throw.",1,null,null,"61275","540","MadeFreeThrow"],[2,"3:03","248",65,64,0,0,"Foul on Galen Robinson Jr..",0,null,null,"3907780","519","PersonalFoul"],[2,"3:01","41",65,64,0,2,"Shonn Miller missed Jumper.",1,null,null,"56330","20558","JumpShot"],[2,"3:01","248",65,64,0,0,"Damyean Dotson Defensive Rebound.",0,null,null,"61674","587","Defensive Rebound"],[2,"2:46","248",67,64,1,2,"Galen Robinson Jr. made Layup.",1,null,null,"3907780","20572","LayUpShot"],[2,"2:45","41",67,64,0,0,"Connecticut  Timeout",0,null,null,null,"579","ShortTimeOut"],[2,"2:27","41",67,66,1,2,"Daniel Hamilton made Jumper.",1,null,null,"3147351","20558","JumpShot"],[2,"1:56","248",69,66,1,2,"LeRon Barnes made Jumper. Assisted by Damyean Dotson.",1,null,null,"56260","20558","JumpShot"],[2,"1:40","41",69,66,0,3,"Sterling Gibbs missed Three Point Jumper.",1,null,null,"57408","30558","Three Point Jump Shot"],[2,"1:40","248",69,66,0,0,"Damyean Dotson Defensive Rebound.",0,null,null,"61674","587","Defensive Rebound"],[2,"1:34","248",69,66,0,0,"Houston  Timeout",0,null,null,null,"578","RegularTimeOut"],[2,"1:08","248",72,66,1,3,"Damyean Dotson made Three Point Jumper.",1,null,null,"61674","30558","Three Point Jump Shot"],[2,"0:55","41",72,66,0,2,"Jalen Adams missed Layup.",1,null,null,"3934622","20572","LayUpShot"],[2,"0:55","41",72,66,0,0,"Shonn Miller Offensive Rebound.",0,null,null,"56330","586","Offensive Rebound"],[2,"0:52","41",72,68,1,2,"Shonn Miller made Two Point Tip Shot.",1,null,null,"56330","20437","TipShot"],[2,"0:41","41",72,68,0,0,"Foul on Sterling Gibbs.",0,null,null,"57408","519","PersonalFoul"],[2,"0:36","41",72,68,0,0,"Foul on Sterling Gibbs.",0,null,null,"57408","519","PersonalFoul"],[2,"0:36","248",72,68,0,1,"Ronnie Johnson missed Free Throw.",1,null,null,"61275","540","MadeFreeThrow"],[2,"0:36","41",72,68,0,0,"Amida Brimah Defensive Rebound.",0,null,null,"66679","587","Defensive Rebound"],[2,"0:27","41",72,68,0,3,"Daniel Hamilton missed Three Point Jumper.",1,null,null,"3147351","30558","Three Point Jump Shot"],[2,"0:27","41",72,68,0,0,"Connecticut Offensive Rebound.",0,null,null,null,"586","Offensive Rebound"],[2,"0:27","248",72,68,0,0,"Foul on Devonta Pollard.",0,null,null,"61776","519","PersonalFoul"],[2,"0:27","41",72,68,0,0,"Connecticut  Timeout",0,null,null,null,"578","RegularTimeOut"],[2,"0:25","248",72,68,0,0,"Foul on LeRon Barnes.",0,null,null,"56260","519","PersonalFoul"],[2,"0:18","41",72,68,0,3,"Sterling Gibbs missed Three Point Jumper.",1,null,null,"57408","30558","Three Point Jump Shot"],[2,"0:18","248",72,68,0,0,"Devonta Pollard Defensive Rebound.",0,null,null,"61776","587","Defensive Rebound"],[2,"0:17","41",72,68,0,0,"Foul on Daniel Hamilton.",0,null,null,"3147351","519","PersonalFoul"],[2,"0:17","248",73,68,1,1,"Devonta Pollard made Free Throw.",1,null,null,"61776","540","MadeFreeThrow"],[2,"0:17","248",74,68,1,1,"Devonta Pollard made Free Throw.",1,null,null,"61776","540","MadeFreeThrow"],[2,"0:13","41",74,68,0,0,"Jalen Adams Turnover.",0,null,null,"3934622","598","Lost Ball Turnover"],[2,"0:12","41",74,68,0,0,"Foul on Jalen Adams.",0,null,null,"3934622","519","PersonalFoul"],[2,"0:12","248",75,68,1,1,"Ronnie Johnson made Free Throw.",1,null,null,"61275","540","MadeFreeThrow"],[2,"0:11","248",75,68,0,1,"Ronnie Johnson missed Free Throw.",1,null,null,"61275","540","MadeFreeThrow"],[2,"0:11","41",75,68,0,0,"Daniel Hamilton Defensive Rebound.",0,null,null,"3147351","587","Defensive Rebound"],[2,"0:05","41",75,68,0,0,"Jalen Adams Turnover.",0,null,null,"3934622","598","Lost Ball Turnover"],[2,"0:04","248",75,68,0,0,"LeRon Barnes Steal.",0,null,null,"56260","607","Steal"],[2,"0:00",null,75,68,0,0,"End of Game",0,null,null,null,"402","End Game"]],"wp":[],"article":{"headline":"Dotson's double-double leads Houston to 75-68 win at UConn","description":"Damyean Dotson scored 22 points and grabbed 14 rebounds as Houston improved its NCAA resume with a 75-68 win over UConn on Sunday.","type":"Recap","source":"Associated Press","published":"2016-02-28T21:22:52Z","story":"STORRS, Conn. --  Houston forward <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61776/devonta-pollard\">Devonta Pollard</a> says the Cougars are treating every game from this point forward as a must win.\n\nGuard <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61674/damyean-dotson\">Damyean Dotson</a> scored 22 points and grabbed 14 rebounds as Houston improved its NCAA resume Sunday with a 75-68 win over UConn.\n\nPollard added 17 points for the Cougars (21-9, 11-6 American Athletic), who have won five of their last six games.\n\n\"Every game from now on out is a tournament game, that's how we're looking at,\" Pollard said. \"I think we're a tournament team, because we won't stop fighting. We won't go away.\"\n\n<a href=\"http://www.espn.com/mens-college-basketball/player/_/id/3147351/daniel-hamilton\">Daniel Hamilton</a> had 20 points and seven rebounds for UConn (20-9, 10-6), which had won three of four coming in.\n\nThe Huskies led by as many as nine points in the first half. But the Cougars used an 8-0 run at the end of the half to cut the lead to a point and went up by as many as seven in the second half.\n\nHouston took the lead for good on a free throw by <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61275/ronnie-johnson\">Ronnie Johnson</a> with 3:15 to play. A 3-pointer from the right wing by Dotson with 1:08 left extended the lead to 72-66 and the Cougars held on.\n\n\"I just looked at the (shot) clock and there was four seconds left and I couldn't pass it, so I just put it up and it went in,\" he said.\n\nHouston hit its last five shots. UConn missed seven of its last nine.\n\nDonald Knowles and Ronnie Johnson each chipped in with 10 points for the Cougars, who have won six conference road games this season.\n\n\"There is a believability that has to go on within the confines of your team to win on the road, and I think that is one of the things we have,\" said Houston coach Kelvin Sampson.\n\nA Pollard floater over 7-foot center <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/66679/amida-brimah\">Amida Brimah</a> gave Houston its first lead since 2-0 at 39-37 early in the second half, part of a 9-0 run that saw the Cougars take a seven-point lead.\n\nA lob pass from Gibbs to Brimah brought the Huskies back to within one at 51-50 and brought the crowd back into the game.\n\nThe teams went back and forth from there.\n\nUConn opened the game on an 8-2 run thanks in part to three early rebounds from Brimah, who finished with 10 points and seven rebounds.\n\nA tomahawk dunk by <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/61157/rodney-purvis\">Rodney Purvis</a> off a Houston turnover brought the crowd into the game and gave UConn a 24-15 lead.\n\n\"Coach called timeout and said stay within yourself, play, make the right pass, be unselfish and just play how we know how to play,\" Dotson said.\n\nThe Cougars responded by scoring the next five to get back to within four after a layup by Rod Gray Jr. The sophomore guard came into the game as the Cougar's leading scorer, averaging 17.1 points off the bench. But he is still recovering from an ankle sprain and was held to just two points in 16 minutes.\n\nThe Huskies had several opportunities to extend the lead to double digits, but would miss a foul shot, or turn the ball over.\n\nUConn gave back a Houston turnover when Daniel Hamilton's long pass on a fast-break was intercepted and Dotson turned a missed 3-pointer by Ronnie Johnson into a highlight reel dunk. Dotson had 10 of his points before halftime and the Cougars trailed just 33-32.\n\n\"It just comes down to toughness and I'm going to stop my man,\" UConn coach Kevin Ollie said. \"That's pretty much what it comes down to. And the lack of effort that we showed out here is very disappointing.\"\n\nThe teams came into the game with identical records, but UConn had an RPI of 42, while Houston's was 88, making the game a must-win for the Cougars, who have won eight more games than a year ago.\n\nThe teams split the season series. The Huskies won 69-57 in Houston last month.\n\n---\n\nTIP-INS:\n\nHouston: <a href=\"http://www.espn.com/mens-college-basketball/player/_/id/3907780/galen-robinson-jr\">Galen Robinson Jr.</a>'s three assists give him 101 for the season. He's just the sixth freshman in Houston history to reach that milestone, and the first since Desmond Wade had 113 in 2008-09.\n\nUConn: It was the Huskies first loss on campus this season. UConn came into the game 7-0 at Gampel Pavilion and 5-2 in Hartford at the XL Center. They have one home game, at Gampel next Saturday against UCF before the conference tournament.\n\nUP NEXT:\n\nHouston: The Cougars close the regular season at home on Thursday against Cincinnati.\n\nUConn: The Huskies visit No. 24 SMU on Thursday.","images":[]},"videos":[],"news":[],"source":{"summary":true,"boxscore":"full","playByPlay":"full"}}