{"id":"401485279","season":2023,"seasonType":2,"date":"2023-02-25T17:00Z","timeTBD":false,"status":"final","statusDetail":"Final","ot":0,"neutral":false,"conferenceGame":true,"note":null,"notes":null,"venue":{"id":"1830","name":"Madison Square Garden","city":"New York","state":"NY"},"attendance":12241,"officials":["Pat Driscoll","Jeff Clark","Tony Chiazza"],"broadcasts":["CBS"],"uconn":0,"teams":[{"homeAway":"away","id":"41","abbr":"CONN","name":"UConn Huskies","shortName":"UConn","location":"UConn","nickname":"Huskies","color":"0c2340","altColor":"a2aaad","logo":"https://a.espncdn.com/i/teamlogos/ncaa/500/41.png","rank":18,"record":"22-7","confRecord":"11-7","score":95,"winner":true,"linescores":[50,45],"stats":{"FG":"30-64","Field Goal %":47,"3PT":"9-25","Three Point %":36,"FT":"26-33","Free Throw %":79,"Rebounds":38,"Offensive Rebounds":17,"Defensive Rebounds":21,"Assists":17,"Steals":9,"Blocks":11,"Turnovers":14,"Team Turnovers":0,"Total Turnovers":14,"Technical Fouls":1,"Total Technical Fouls":1,"Flagrant Fouls":0,"Points Off Turnovers":13,"Fast Break Points":19,"Points in Paint":34,"Fouls":21,"Largest Lead":15},"players":[{"id":"4917149","name":"Alex Karaban","short":"A. Karaban","jersey":"11","pos":"F","starter":true,"dnp":false,"headshot":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/4917149.png","min":19,"pts":2,"fgm":1,"fga":5,"tpm":0,"tpa":3,"ftm":0,"fta":0,"reb":5,"oreb":1,"dreb":4,"ast":0,"to":2,"stl":1,"blk":1,"pf":4},{"id":"4702023","name":"Adama Sanogo","short":"A. Sanogo","jersey":"21","pos":"C","starter":true,"dnp":false,"headshot":"https://a.espncdn.com/i/headshots/mens-college-basketball/players/full/4702023.png","min":26,"pts":18,"fgm":5,"fga":9,"tpm":0,"tpa":1,"ftm":8,"fta":10,"reb":9,"oreb":3,"dreb":6,"ast":1,"to":2,"stl":0,"blk":1,"pf":3},{"id":"4683750","name":"Jordan Hawkins","short":"J. Hawkins","jersey":"24","pos":"G","starter":true,"dnp":false,"headshot":"https://a.espncdn.com/i/headshots/mens-college-basketball