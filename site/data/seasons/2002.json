{"y":2002,"label":"2001–02","coach":"Jim Calhoun","conf":"Big East MBB East","confShort":"Big East MBB East","w":27,"l":7,"cw":13,"cl":3,"confFinish":"1st in Big East MBB East","finish":"elite8","seed":2,"region":"East","apHigh":10,"apFinal":10,"srs":15.38,"sos":7.59,"ortg":107.3,"drtg":95.4,"ppg":77.8,"oppg":69.2,"story":{"headline":"Caron Butler's Big East Crown","text":"Sophomore Caron Butler averaged 20.3 points and 7.5 rebounds and carried UConn to a 27–7 season, the Big East East Division title and the Big East tournament crown. Freshman Ben Gordon hit the game-winning three against Villanova in the quarterfinals, UConn beat Notre Dame in the semis, and the Huskies outlasted Pittsburgh 74–65 in double overtime in the final. Butler was tournament MVP and shared Big East Player of the Year with Pitt's Brandin Knight. Earlier the Huskies had won 100–98 in overtime at No. 10 Arizona. As a No. 2 seed, UConn beat Hampton, NC State and Southern Illinois before Butler's 32 points weren't enough in a 90–82 Elite Eight loss to eventual national champion Maryland. Butler went 10th overall to the Miami Heat, while freshmen Emeka Okafor and Ben Gordon made the All-Freshman team.","moments":[{"date":"2002-03-09","title":"Big East tournament Championship: W vs Pittsburgh","text":"UConn beat Pittsburgh 74–65 (2OT) (Championship) at Madison Square Garden, New York, NY."},{"date":"2002-03-15","title":"NCAA First Round: W vs Hampton","text":"UConn beat Hampton 78–67 in the NCAA tournament first round at MCI Center, Washington, D.C."},{"date":"2002-03-17","title":"NCAA Second Round: W vs NC State","text":"UConn beat NC State 77–74 in the NCAA tournament second round at MCI Center, Washington, D.C."},{"date":"2002-03-22","title":"NCAA Sweet Sixteen: W vs Southern Illinois","text":"UConn beat Southern Illinois 71–59 in the NCAA tournament sweet sixteen at Carrier Dome, Syracuse, NY."},{"date":"2002-03-24","title":"NCAA Elite Eight: L vs Maryland","text":"UConn lost to Maryland 82–90 in the NCAA tournament elite eight at Carrier Dome, Syracuse, NY."}],"honors":["Big East tournament champions","Big East East Division regular-season champions","Caron Butler – Big East Co-Player of the Year","Caron Butler – Big East Tournament MVP","Caron Butler – First-team All-Big East"],"sources":["https://en.wikipedia.org/wiki/2001%E2%80%9302_Connecticut_Huskies_men's_basketball_team","https://en.wikipedia.org/wiki/UConn_Huskies_men%27s_basketball","https://en.wikipedia.org/wiki/Caron_Butler","https://en.wikipedia.org/wiki/Ben_Gordon"]},"roster":[{"pid":"caron-butler-1","name":"Caron Butler","num":"3","cls":"SO","pos":"F","ht":"6-7","wt":217,"home":"Racine, WI","rsci":"60 ( 1999 ), 47 ( 2000 )","photo":"https://a.espncdn.com/i/headshots/nba/players/full/1705.png","pg":{"g":34,"gs":34,"mp":36.0,"pts":20.3,"trb":7.5,"ast":3.0,"stl":2.1,"blk":0.4,"tov":2.9,"fg_pct":0.486,"fg3_pct":0.4,"ft_pct":0.779,"orb":3.2,"pf":2.2},"tot":{"mp":1223,"fg":253,"fga":521,"fg3":30,"fg3a":75,"ft":155,"fta":199,"orb":108,"drb":148,"trb":256,"ast":101,"stl":71,"blk":13,"tov":98,"pf":75,"pts":691,"g":34},"adv":{"per":null,"ts_pct":0.561,"efg_pct":0.514,"usg_pct":null,"ast_pct":null,"trb_pct":null,"stl_pct":null,"blk_pct":null,"ws":5.7,"ws_per_40":0.188,"bpm":null,"obpm":null,"dbpm":null}},{"pid":"ben-gordon-1","name":"Ben Gordon","num":"4","cls":"FR","pos":"G","ht":"6-3","wt":200,"home":"Mount Vernon, NY","rsci":"41 ( 2001 )","photo":"https://cdn.nba.com/headshots/nba/latest/1040x760/2732.png","pg":{"g":34,"gs":2,"mp":24.8,"pts":12.6,"trb":2.7,"ast":3.1,"stl":1.0,"blk":0.2,"tov":2.4,"fg_pct":0.444,"fg3_pct":0.413,"ft_pct":0.726,"orb":0.6,"pf":2.4},"tot":{"mp":844,"fg":140,"fga":315,"fg3":62,"fg3a":150,"ft":85,"fta":117,"orb":20,"drb":73,"trb":93,"ast":105,"stl":34,"blk":6,"tov":81,"pf":80,"pts":427,"g":34},"adv":{"per":null,"ts_pct":0.576,"efg_pct":0.543,"usg_pct":null,"ast_pct":null,"trb_pct":null,"stl_pct":null,"blk_pct":null,"ws":3.5,"ws_per_40":0.167,"bpm":null,"obpm":null,"dbpm"